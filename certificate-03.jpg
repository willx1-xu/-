:root{--navy:#061a31;--navy2:#0a2949;--blue:#126DFF;--green:#20B26B;--orange:#FF8A1D;--ink:#102033;--muted:#65748a;--soft:#F4F7FA;--line:#DDE7F0;--white:#fff;--shadow:0 24px 70px rgba(6,26,49,.14);--shadow2:0 14px 35px rgba(6,26,49,.08);--max:1180px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);line-height:1.58;background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.container{width:min(var(--max),calc(100% - 42px));margin:auto}
