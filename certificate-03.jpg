footer{background:#041326;color:rgba(255,255,255,.68);padding:50px 0 26px}.footer-grid{display:grid;grid-template-columns:1.25fr repeat(4,1fr);gap:28px;border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:30px}.footer-grid h4{color:white;margin:0 0 12px}.footer-grid ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:14px}.footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:22px}
@media(max-width:1100px){.grid-5,.grid-4{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:repeat(2,1fr)}}
