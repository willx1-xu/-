<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Quality & Manufacturing | Apex Power Systems</title><meta name="description" content="Apex Power Systems manufacturing, testing, quality control, production workshop, and export delivery capability for power distribution and EV charging equipment."><style>
:root{--navy:#061a31;--navy2:#0a2949;--blue:#126DFF;--green:#20B26B;--orange:#FF8A1D;--ink:#102033;--muted:#65748a;--soft:#F4F7FA;--line:#DDE7F0;--white:#fff;--shadow:0 24px 70px rgba(6,26,49,.14);--shadow2:0 14px 35px rgba(6,26,49,.08);--max:1180px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);line-height:1.58;background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.container{width:min(var(--max),calc(100% - 42px));margin:auto}
.topbar{background:var(--navy);color:rgba(255,255,255,.78);font-size:13px}.topbar .container{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:9px 0}
header{position:sticky;top:0;background:rgba(255,255,255,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);z-index:40}.nav{height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;color:var(--navy);font-weight:900;font-size:20px;letter-spacing:-.03em}.mark{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--blue),var(--green));display:grid;place-items:center;color:#fff}.navlinks{display:flex;gap:20px;font-size:14px;font-weight:800;color:#334b66}.navlinks a:hover{color:var(--blue)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border-radius:999px;font-weight:850;font-size:14px;border:1px solid transparent}.btn-orange{background:linear-gradient(135deg,var(--orange),#ffb03a);color:#15110a;box-shadow:0 14px 30px rgba(255,138,29,.24)}.btn-white{background:#fff;color:var(--navy);border-color:var(--line)}.btn-blue{background:linear-gradient(135deg,var(--blue),#13b8ff);color:#fff}
.hero{background:radial-gradient(circle at 80% 15%,rgba(29,211,255,.23),transparent 30%),linear-gradient(135deg,#061a31,#0a2949);color:white}.hero .container{display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center;padding:72px 0}.kicker{display:block;text-transform:uppercase;letter-spacing:.1em;color:var(--blue);font-weight:950;font-size:12px;margin-bottom:12px}.hero .kicker{color:#9cefff}
h1{font-size:clamp(38px,5vw,64px);line-height:1;letter-spacing:-.055em;margin:0 0 20px}.hero p{color:rgba(255,255,255,.8);font-size:18px;margin:0 0 28px}.hero-img{background:#fff;border-radius:28px;padding:18px;box-shadow:var(--shadow)}.hero-img img{height:410px;width:100%;object-fit:cover;border-radius:18px}
section{padding:76px 0}h2{font-size:clamp(30px,4vw,46px);line-height:1.08;color:var(--navy);letter-spacing:-.045em;margin:0 0 18px}.lead{color:var(--muted);font-size:17px;max-width:850px}.soft{background:var(--soft)}.grid{display:grid;gap:22px}.grid-5{grid-template-columns:repeat(5,1fr)}.grid-4{grid-template-columns:repeat(4,1fr)}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:repeat(2,1fr)}
.card{background:white;border:1px solid var(--line);border-radius:24px;padding:26px;box-shadow:var(--shadow2);overflow:hidden}.card h3{margin:0 0 10px;color:var(--navy)}.card p{margin:0;color:var(--muted)}.card img{width:100%;height:220px;object-fit:cover;background:#f7fafd;border-radius:16px;margin-bottom:16px}.card.contain img{object-fit:contain;padding:10px}
.step b{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--blue),var(--green));color:#fff;margin-bottom:16px}.tag{display:inline-flex;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:var(--blue);background:#eef5ff;padding:6px 9px;border-radius:999px;margin-bottom:12px}
.applications{display:flex;gap:10px;flex-wrap:wrap}.applications span{padding:10px 12px;border-radius:999px;background:white;border:1px solid var(--line);font-weight:800;color:#28425a;font-size:13px}
table{width:100%;border-collapse:collapse;background:white;border-radius:24px;overflow:hidden;box-shadow:var(--shadow2)}td,th{padding:16px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:#eef5ff;color:var(--navy)}tr:last-child td{border-bottom:none}
.faq details{background:white;border:1px solid var(--line);border-radius:18px;padding:18px 20px;box-shadow:0 10px 24px rgba(6,26,49,.05);margin-bottom:12px}.faq summary{font-weight:900;color:var(--navy);cursor:pointer}.faq p{color:var(--muted);margin:10px 0 0}
.rfq{background:linear-gradient(135deg,var(--navy),var(--navy2));color:white;border-radius:30px;padding:40px;display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;box-shadow:var(--shadow)}.rfq h2{color:white}.rfq p{color:rgba(255,255,255,.76)}form{background:white;border-radius:24px;padding:24px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:14px;padding:14px;font:inherit}textarea,.full{grid-column:1/-1}textarea{min-height:110px}.crumb{font-size:13px;color:rgba(255,255,255,.74);margin-bottom:18px}.crumb a{text-decoration:underline;text-underline-offset:3px}
footer{background:#041326;color:rgba(255,255,255,.68);padding:50px 0 26px}.footer-grid{display:grid;grid-template-columns:1.25fr repeat(4,1fr);gap:28px;border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:30px}.footer-grid h4{color:white;margin:0 0 12px}.footer-grid ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:14px}.footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:22px}.mini{font-size:13px;color:var(--muted)}
@media(max-width:1100px){.grid-5,.grid-4{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:repeat(2,1fr)}.navlinks{display:none}}
@media(max-width:950px){.hero .container,.grid-5,.grid-4,.grid-3,.grid-2,.rfq,.footer-grid{grid-template-columns:1fr}.hero-img img{height:300px}.form-grid{grid-template-columns:1fr}textarea,.full{grid-column:auto}.topbar{display:none}.hero .container{padding:52px 0}section{padding:58px 0}h1{font-size:40px}.brand{font-size:18px}}
</style>
